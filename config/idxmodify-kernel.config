#
# idxmodify custom kernel config
# Gzip-compressed kernel for maximum boot compatibility
# Minimal but full storage support
#
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_GZIP=y
CONFIG_INITRAMFS_SOURCE=""
CONFIG_KERNEL_GZIP=y
CONFIG_KERNEL_XZ=y
CONFIG_KERNEL_LZMA=y
CONFIG_KERNEL_ZSTD=y
CONFIG_KERNEL_GZIP=y
CONFIG_SMP=y
CONFIG_MCORE2=y
CONFIG_HZ_1000=y
CONFIG_LOCALVERSION="-idxmodify"
CONFIG_64BIT=y
CONFIG_X86_64=y

# Filesystems needed for boot
CONFIG_EXT2_FS=y
CONFIG_EXT3_FS=y
CONFIG_EXT4_FS=y
CONFIG_VFAT_FS=y
CONFIG_FAT_FS=y
CONFIG_SQUASHFS=y
CONFIG_SQUASHFS_ZLIB=y
CONFIG_TMPFS=y
CONFIG_PROC_FS=y
CONFIG_SYSFS=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y

# Storage drivers
CONFIG_ATA=y
CONFIG_SATA_AHCI=y
CONFIG_SATA_AHCI_PLATFORM=y
CONFIG_ATA_PIIX=y
CONFIG_SCSI=y
CONFIG_BLK_DEV_SD=y
CONFIG_BLK_DEV_SR=y
CONFIG_BLK_DEV_NVME=y
CONFIG_NVME_CORE=y
CONFIG_BLK_DEV_LOOP=y
CONFIG_BLK_DEV_RAM=y
CONFIG_BLK_DEV_RAM_SIZE=65536
CONFIG_USB=y
CONFIG_USB_EHCI_HCD=y
CONFIG_USB_XHCI_HCD=y
CONFIG_USB_STORAGE=y

# Input for keyboard
CONFIG_INPUT=y
CONFIG_INPUT_KEYBOARD=y
CONFIG_KEYBOARD_ATKBD=y
CONFIG_VT=y
CONFIG_VT_CONSOLE=y
CONFIG_TTY=y

# Misc needed
CONFIG_PRINTK=y
CONFIG_BINFMT_ELF=y
CONFIG_UNIX98_PTYS=y
CONFIG_MODULES=y
CONFIG_MODULE_UNLOAD=y
CONFIG_CRYPTO=y
CONFIG_CRYPTO_SHA256=y
CONFIG_CRC32=y
