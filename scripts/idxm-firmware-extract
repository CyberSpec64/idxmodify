#!/bin/sh
#==============================================================================
# idxmodify - Firmware Extraction Tool
#==============================================================================

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
CYAN='\033[0;36m'
NC='\033[0m'

usage() {
    cat << EOF
${CYAN}idxm-firmware-extract${NC} - Extract firmware from various devices

Usage: idxm-firmware-extract [options] <device> <output>

Options:
    -t, --type <type>    Device type (auto, bios, nic, raid, nvme)
    -r, --read-count     Number of read attempts
    -b, --block-size     Block size for reading
    -f, --force          Force extraction
    -v, --verbose        Verbose output
    -h, --help           Show this help

Device Types:
    auto        Auto-detect device type (default)
    bios        BIOS/UEFI firmware
    nic         Network interface card firmware
    raid        RAID controller firmware
    nvme        NVMe SSD firmware

Examples:
    idxm-firmware-extract /dev/sda bios.bin
    idxm-firmware-extract -t nic eth0 firmware.bin
    idxm-firmware-extract -t nvme /dev/nvme0n1 nvme_fw.bin

EOF
}

# Main extraction logic
extract_firmware() {
    local device="$1"
    local output="$2"
    local dev_type="${3:-auto}"
    local block_size="${4:-1M}"
    
    if [  ! -b "$device"  ]; then
        echo -e "${RED}Error: $device is not a block device${NC}"
        return 1
    fi
    
    echo -e "${CYAN}Extracting firmware from $device...${NC}"
    echo -e "Device type: $dev_type"
    echo -e "Output: $output"
    echo -e "Block size: $block_size"
    echo ""
    
    # Method 1: Use flashrom for BIOS
    if [  "$dev_type" == "bios"  ] || [  "$dev_type" == "auto"  ]; then
        if command -v flashrom >/dev/null 2>&1; then
            echo -e "${GREEN}Using flashrom...${NC}"
            flashrom -p internal -r "$output" -V
            if [  $? -eq 0  ]; then
                echo -e "${GREEN}Firmware extracted successfully${NC}"
                return 0
            fi
        fi
    fi
    
    # Method 2: Use dd for raw extraction
    echo -e "${YELLOW}Using dd for raw extraction...${NC}"
    dd if="$device" of="$output" bs="$block_size" status=progress
    
    if [  $? -eq 0  ]; then
        echo -e "${GREEN}Raw firmware extracted${NC}"
        
        # Calculate checksums
        echo ""
        echo -e "${CYAN}Checksums:${NC}"
        echo -e "MD5:    $(md5sum "$output" | cut -d' ' -f1)"
        echo -e "SHA1:   $(sha1sum "$output" | cut -d' ' -f1)"
        echo -e "SHA256: $(sha256sum "$output" | cut -d' ' -f1)"
    else
        echo -e "${RED}Extraction failed${NC}"
        return 1
    fi
}

# Parse arguments
DEVICE=""
OUTPUT=""
DEV_TYPE="auto"
BLOCK_SIZE="1M"
FORCE=0
VERBOSE=0

while [  $# -gt 0  ]; do
    case "$1" in
        -t|--type)
            DEV_TYPE="$2"
            shift 2
            ;;
        -b|--block-size)
            BLOCK_SIZE="$2"
            shift 2
            ;;
        -f|--force)
            FORCE=1
            shift
            ;;
        -v|--verbose)
            VERBOSE=1
            shift
            ;;
        -h|--help)
            usage
            exit 0
            ;;
        *)
            if [  -z "$DEVICE"  ]; then
                DEVICE="$1"
            elif [  -z "$OUTPUT"  ]; then
                OUTPUT="$1"
            fi
            shift
            ;;
    esac
done

# Validate arguments
if [  -z "$DEVICE"  ]; then
    echo -e "${RED}Error: Device required${NC}"
    usage
    exit 1
fi

if [  -z "$OUTPUT"  ]; then
    OUTPUT="firmware_$(date +%Y%m%d_%H%M%S).bin"
fi

# Run extraction
extract_firmware "$DEVICE" "$OUTPUT" "$DEV_TYPE" "$BLOCK_SIZE"
