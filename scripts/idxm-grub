#!/bin/sh
#==============================================================================
# idxmodify - GRUB Manager
#==============================================================================

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
CYAN='\033[0;36m'
NC='\033[0m'

usage() {
    cat << EOF
${CYAN}idxm-grub${NC} - GRUB Bootloader Manager

Usage: idxm-grub [options] <command>

Commands:
    install <device>        Install GRUB to device
    update <device>         Update GRUB configuration
    remove <device>         Remove GRUB
    rescue <device>         Boot into rescue mode
    shell <device>          Enter GRUB shell
    backup <device>         Backup GRUB configuration
    restore <device>        Restore GRUB configuration
    list <device>           List GRUB entries

Options:
    -m, --mount <point>     Mount point for OS
    -f, --force             Force operation
    -v, --verbose           Verbose output
    -h, --help              Show this help

Examples:
    idxm-grub install /dev/sda
    idxm-grub update /dev/sda
    idxm-grub backup /dev/sda

EOF
}

install_grub() {
    local device="$1"
    local mountpoint="${2:-/mnt}"
    
    echo -e "${CYAN}Installing GRUB to $device...${NC}"
    
    # Mount the root partition
    local root_part=$(lsblk -ln -o MOUNTPOINT "$device" | head -1)
    if [  -n "$root_part"  ]; then
        mountpoint="$root_part"
    fi
    
    if [  ! -d "$mountpoint/boot"  ]; then
        echo -e "${RED}Error: No /boot directory found${NC}"
        return 1
    fi
    
    # Detect if UEFI or BIOS
    if [  -d /sys/firmware/efi  ]; then
        echo -e "${GREEN}UEFI mode detected${NC}"
        grub-install --target=x86_64-efi --efi-directory="$mountpoint/boot/efi" --bootloader-id=idxmodify
    else
        echo -e "${GREEN}BIOS mode detected${NC}"
        grub-install --target=i386-pc --boot-directory="$mountpoint/boot" "$device"
    fi
    
    if [  $? -eq 0  ]; then
        echo -e "${GREEN}GRUB installed successfully${NC}"
    else
        echo -e "${RED}GRUB installation failed${NC}"
        return 1
    fi
}

update_grub() {
    local device="$1"
    local mountpoint="${2:-/mnt}"
    
    echo -e "${CYAN}Updating GRUB configuration...${NC}"
    
    # Chroot and update
    mount --bind /dev "$mountpoint/dev" 2>/dev/null || true
    mount --bind /dev/pts "$mountpoint/dev/pts" 2>/dev/null || true
    mount -t proc none "$mountpoint/proc" 2>/dev/null || true
    mount -t sysfs none "$mountpoint/sys" 2>/dev/null || true
    
    chroot "$mountpoint" /bin/sh -c "
        if command -v update-grub >/dev/null 2>&1; then
            update-grub
        elif command -v grub-mkconfig >/dev/null 2>&1; then
            grub-mkconfig -o /boot/grub/grub.cfg
        fi
    "
    
    umount "$mountpoint/dev/pts" 2>/dev/null || true
    umount "$mountpoint/dev" 2>/dev/null || true
    umount "$mountpoint/proc" 2>/dev/null || true
    umount "$mountpoint/sys" 2>/dev/null || true
    
    echo -e "${GREEN}GRUB configuration updated${NC}"
}

backup_grub() {
    local device="$1"
    local mountpoint="${2:-/mnt}"
    local backup_dir="/root/grub_backup_$(date +%Y%m%d_%H%M%S)"
    
    echo -e "${CYAN}Backing up GRUB configuration...${NC}"
    
    mkdir -p "$backup_dir"
    
    # Backup GRUB config
    if [  -f "$mountpoint/boot/grub/grub.cfg"  ]; then
        cp "$mountpoint/boot/grub/grub.cfg" "$backup_dir/"
    fi
    
    # Backup other GRUB files
    if [  -d "$mountpoint/boot/grub"  ]; then
        cp -r "$mountpoint/boot/grub/"* "$backup_dir/" 2>/dev/null || true
    fi
    
    echo -e "${GREEN}Backup saved to: $backup_dir${NC}"
    ls -la "$backup_dir"
}

restore_grub() {
    local device="$1"
    local mountpoint="${2:-/mnt}"
    local backup_dir="$3"
    
    if [  -z "$backup_dir"  ]; then
        # Find latest backup
        backup_dir=$(ls -d /root/grub_backup_* 2>/dev/null | tail -1)
    fi
    
    if [  ! -d "$backup_dir"  ]; then
        echo -e "${RED}Error: No backup found${NC}"
        return 1
    fi
    
    echo -e "${CYAN}Restoring GRUB from $backup_dir...${NC}"
    
    cp "$backup_dir/grub.cfg" "$mountpoint/boot/grub/grub.cfg" 2>/dev/null
    
    echo -e "${GREEN}GRUB restored${NC}"
}

rescue_grub() {
    local device="$1"
    
    echo -e "${CYAN}Loading GRUB rescue mode...${NC}"
    
    # This would typically be done via boot parameters
    # For live environment, we can modify the GRUB config
    echo "To boot into rescue mode, add 'single' or 'rescue' to kernel parameters"
    echo ""
    echo "Example:"
    echo "  In GRUB menu, press 'e' to edit, add 'single' to linux line"
}

list_entries() {
    local device="$1"
    local mountpoint="${2:-/mnt}"
    
    echo -e "${CYAN}GRUB Entries:${NC}"
    echo "═══════════════════════════════════════════════════════════════"
    
    if [  -f "$mountpoint/boot/grub/grub.cfg"  ]; then
        grep -E "^menuentry|^submenu" "$mountpoint/boot/grub/grub.cfg" | \
            sed 's/menuentry/  Entry/' | sed 's/submenu/  Submenu/'
    else
        echo "No GRUB configuration found"
    fi
}

# Parse arguments
DEVICE=""
MOUNTPOINT="/mnt"
COMMAND=""
FORCE=0
VERBOSE=0

while [  $# -gt 0  ]; do
    case "$1" in
        install|update|remove|rescue|shell|backup|restore|list)
            COMMAND="$1"
            shift
            ;;
        -m|--mount)
            MOUNTPOINT="$2"
            shift 2
            ;;
        -f|--force)
            FORCE=1
            shift
            ;;
        -v|--verbose)
            VERBOSE=1
            shift
            ;;
        -h|--help)
            usage
            exit 0
            ;;
        *)
            if [  -z "$DEVICE"  ]; then
                DEVICE="$1"
            fi
            shift
            ;;
    esac
done

if [  -z "$COMMAND"  ]; then
    usage
    exit 1
fi

case "$COMMAND" in
    install)
        [  -z "$DEVICE"  ] && { echo -e "${RED}Device required${NC}"; exit 1; }
        install_grub "$DEVICE" "$MOUNTPOINT"
        ;;
    update)
        [  -z "$DEVICE"  ] && { echo -e "${RED}Device required${NC}"; exit 1; }
        update_grub "$DEVICE" "$MOUNTPOINT"
        ;;
    backup)
        [  -z "$DEVICE"  ] && { echo -e "${RED}Device required${NC}"; exit 1; }
        backup_grub "$DEVICE" "$MOUNTPOINT"
        ;;
    restore)
        [  -z "$DEVICE"  ] && { echo -e "${RED}Device required${NC}"; exit 1; }
        restore_grub "$DEVICE" "$MOUNTPOINT"
        ;;
    rescue)
        [  -z "$DEVICE"  ] && { echo -e "${RED}Device required${NC}"; exit 1; }
        rescue_grub "$DEVICE"
        ;;
    list)
        [  -z "$DEVICE"  ] && { echo -e "${RED}Device required${NC}"; exit 1; }
        list_entries "$DEVICE" "$MOUNTPOINT"
        ;;
    shell)
        echo "Entering GRUB shell..."
        grub-shell 2>/dev/null || grub 2>/dev/null || echo "GRUB shell not available"
        ;;
    remove)
        [  -z "$DEVICE"  ] && { echo -e "${RED}Device required${NC}"; exit 1; }
        echo -e "${RED}Warning: This will remove GRUB from $DEVICE${NC}"
        read -p "Are you sure? (yes/no): " confirm
        [  "$confirm" == "yes"  ] && echo "GRUB removal not implemented for safety"
        ;;
esac
