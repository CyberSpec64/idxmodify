#!/bin/sh
#==============================================================================
# idxmodify - Interactive TUI Menu System
#==============================================================================

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
CYAN='\033[0;36m'
MAGENTA='\033[0;35m'
WHITE='\033[1;37m'
NC='\033[0m'

# Box drawing characters
H_LINE="─"
V_LINE="│"
TL="┌"
TR="┐"
BL="└"
BR="┘"
LT="├"
RT="┤"
TT="┬"
BT="┴"
X="┼"

draw_box() {
    local title="$1"
    local width="$2"
    local x="$3"
    local y="$4"
    
    # Move cursor and draw
    printf "\033[${y};${x}H"
    printf "${TL}"
    printf "${H_LINE}%.0s" $(seq 1 $((width-2)))
    printf "${TR}"
    
    printf "\033[$((y+1));${x}H"
    printf "${V_LINE}"
    printf "%$(((width-2)/2))s${WHITE}${title}${NC}%$(((width-2+${#title})/2))s"
    printf "${V_LINE}"
    
    printf "\033[$((y+2));${x}H"
    printf "${BL}"
    printf "${H_LINE}%.0s" $(seq 1 $((width-2)))
    printf "${BR}"
}

draw_menu() {
    local title="$1"
    shift
    # options passed as $@ are not arrays in ash; render them directly
    local width=50
    local start_y=3
    
    clear
    echo -e "${CYAN}"
    echo "╔══════════════════════════════════════════════════════════╗"
    echo "║           idxmodify - Firmware & Disk Tools             ║"
    echo "╚══════════════════════════════════════════════════════════╝"
    echo -e "${NC}"
    
    echo -e "\n${WHITE}${title}${NC}\n"
    
    local i=1
    for option in "$@"; do
        echo -e "  ${CYAN}[${i}]${NC} ${option}"
        i=$((i+1))
    done
    
    echo ""
}

spinner() {
    local pid=$1
    local delay=0.1
    local spinstr='⠋⠙⠹⠸⠼⠴⠦⠧⠇⠏'
    
    while (ps -p $pid > /dev/null); do
        local n=0
        while [ "$n" -lt "${#spinstr}" ]; do
            printf "\r  ${CYAN}%s${NC} Processing..." "$(echo "$spinstr" | cut -c $((n+1)))"
            sleep $delay
            n=$((n+1))
        done
    done
    printf "\r"
}

progress_bar() {
    local current=$1
    local total=$2
    local width=50
    local percentage=$((current * 100 / total))
    local filled=$((current * width / total))
    local empty=$((width - filled))
    
    printf "\r  ["
    printf "%0.s█" $(seq 1 $filled)
    printf "%0.s░" $(seq 1 $empty)
    printf "] %d%%" "$percentage"
}

# Main interactive menu
main_menu() {
    while true; do
        draw_menu "Main Menu" \
            "Firmware Tools" \
            "Disk Management" \
            "OS Modification" \
            "System Information" \
            "Forensic Tools" \
            "Settings" \
            "Exit"
        
        read -p "  Select option [1-7]: " choice
        
        case "$choice" in
            1) firmware_menu ;;
            2) disk_menu ;;
            3) os_menu ;;
            4) sys_menu ;;
            5) forensic_menu ;;
            6) settings_menu ;;
            7)
                echo -e "\n${GREEN}Goodbye!${NC}\n"
                exit 0
                ;;
            *)
                echo -e "${RED}Invalid option${NC}"
                sleep 1
                ;;
        esac
    done
}

firmware_menu() {
    while true; do
        draw_menu "Firmware Tools" \
            "Extract Firmware" \
            "Flash Firmware" \
            "Verify Firmware" \
            "Backup Firmware" \
            "Firmware Info" \
            "Back to Main Menu"
        
        read -p "  Select option [1-6]: " choice
        
        case "$choice" in
            1)
                read -p "  Source device (e.g., /dev/sda): " dev
                read -p "  Output file [firmware.bin]: " out
                out=${out:-firmware.bin}
                idxm firmware extract "$dev" "$out"
                read -p "  Press Enter to continue..."
                ;;
            2)
                read -p "  Target device (e.g., /dev/sda): " dev
                read -p "  Firmware file: " fw
                idxm firmware flash "$dev" "$fw"
                read -p "  Press Enter to continue..."
                ;;
            3)
                read -p "  Device (e.g., /dev/sda): " dev
                read -p "  Firmware file: " fw
                idxm firmware verify "$dev" "$fw"
                read -p "  Press Enter to continue..."
                ;;
            4)
                read -p "  Device (e.g., /dev/sda): " dev
                read -p "  Output file [backup.bin]: " out
                out=${out:-backup.bin}
                idxm firmware backup "$dev" "$out"
                read -p "  Press Enter to continue..."
                ;;
            5)
                read -p "  Device (e.g., /dev/sda): " dev
                idxm firmware info "$dev"
                read -p "  Press Enter to continue..."
                ;;
            6) return ;;
            *) echo -e "${RED}Invalid option${NC}"; sleep 1 ;;
        esac
    done
}

disk_menu() {
    while true; do
        draw_menu "Disk Management" \
            "List Disks" \
            "Disk Information" \
            "Partition Disk" \
            "Format Disk" \
            "Clone Disk" \
            "Wipe Disk" \
            "Resize Partition" \
            "Back to Main Menu"
        
        read -p "  Select option [1-8]: " choice
        
        case "$choice" in
            1)
                idxm disk list
                read -p "  Press Enter to continue..."
                ;;
            2)
                read -p "  Device (e.g., /dev/sda): " dev
                idxm disk info "$dev"
                read -p "  Press Enter to continue..."
                ;;
            3)
                read -p "  Device (e.g., /dev/sda): " dev
                idxm disk partition "$dev"
                read -p "  Press Enter to continue..."
                ;;
            4)
                read -p "  Device (e.g., /dev/sda): " dev
                read -p "  Filesystem type (ext4/fat32/ntfs): " fstype
                idxm disk format "$dev" "$fstype"
                read -p "  Press Enter to continue..."
                ;;
            5)
                read -p "  Source device: " src
                read -p "  Destination device: " dst
                idxm disk clone "$src" "$dst"
                read -p "  Press Enter to continue..."
                ;;
            6)
                read -p "  Device to wipe: " dev
                idxm disk wipe "$dev"
                read -p "  Press Enter to continue..."
                ;;
            7)
                read -p "  Device: " dev
                read -p "  Partition number: " part
                idxm disk resize "$dev" "$part"
                read -p "  Press Enter to continue..."
                ;;
            8) return ;;
            *) echo -e "${RED}Invalid option${NC}"; sleep 1 ;;
        esac
    done
}

os_menu() {
    while true; do
        draw_menu "OS Modification" \
            "Mount OS Partition" \
            "Unmount OS" \
            "Chroot into OS" \
            "List Mounted OS" \
            "Modify OS (fix-boot/grub)" \
            "Customize OS" \
            "Install Linux Distro" \
            "GRUB Management" \
            "Back to Main Menu"
        
        read -p "  Select option [1-9]: " choice
        
        case "$choice" in
            1)
                read -p "  Device (e.g., /dev/sda1): " dev
                read -p "  Mount point [/mnt/os]: " mnt
                mnt=${mnt:-/mnt/os}
                idxm os mount "$dev" "$mnt"
                read -p "  Press Enter to continue..."
                ;;
            2)
                read -p "  Mount point [/mnt/os]: " mnt
                mnt=${mnt:-/mnt/os}
                idxm os unmount "$mnt"
                read -p "  Press Enter to continue..."
                ;;
            3)
                read -p "  Device (e.g., /dev/sda2): " dev
                idxm os chroot "$dev"
                read -p "  Press Enter to continue..."
                ;;
            4)
                idxm os list
                read -p "  Press Enter to continue..."
                ;;
            5)
                read -p "  Device: " dev
                echo "  Actions: fix-boot, fix-grub, reset-pass, enable-root"
                read -p "  Action: " action
                idxm os modify "$dev" "$action"
                read -p "  Press Enter to continue..."
                ;;
            6)
                read -p "  Device: " dev
                idxm os customize "$dev"
                read -p "  Press Enter to continue..."
                ;;
            7)
                read -p "  Device: " dev
                echo "  Distributions: debian, ubuntu, arch, fedora, void, alpine"
                read -p "  Distribution: " distro
                idxm os install "$dev" "$distro"
                read -p "  Press Enter to continue..."
                ;;
            8)
                read -p "  Device: " dev
                echo "  Actions: install, update, remove"
                read -p "  Action: " action
                idxm os grub "$dev" "$action"
                read -p "  Press Enter to continue..."
                ;;
            9) return ;;
            *) echo -e "${RED}Invalid option${NC}"; sleep 1 ;;
        esac
    done
}

sys_menu() {
    while true; do
        draw_menu "System Information" \
            "System Info" \
            "Loaded Drivers" \
            "PCI Devices" \
            "USB Devices" \
            "Storage Devices" \
            "Back to Main Menu"
        
        read -p "  Select option [1-6]: " choice
        
        case "$choice" in
            1)
                idxm sys info
                read -p "  Press Enter to continue..."
                ;;
            2)
                idxm sys drivers
                read -p "  Press Enter to continue..."
                ;;
            3)
                idxm sys pci
                read -p "  Press Enter to continue..."
                ;;
            4)
                idxm sys usb
                read -p "  Press Enter to continue..."
                ;;
            5)
                idxm sys storage
                read -p "  Press Enter to continue..."
                ;;
            6) return ;;
            *) echo -e "${RED}Invalid option${NC}"; sleep 1 ;;
        esac
    done
}

forensic_menu() {
    while true; do
        draw_menu "Forensic Tools" \
            "Disk Image (dd)" \
            "Verify Disk Image" \
            "Hash Disk" \
            "Recover Deleted Files" \
            "Hex Viewer" \
            "Back to Main Menu"
        
        read -p "  Select option [1-6]: " choice
        
        case "$choice" in
            1)
                read -p "  Source device: " src
                read -p "  Destination file: " dst
                echo "  Creating forensic image..."
                dd if="$src" of="$dst" bs=4M status=progress conv=sync,noerror
                read -p "  Press Enter to continue..."
                ;;
            2)
                read -p "  Image file: " img
                read -p "  Original device: " dev
                echo "  Verifying..."
                local img_md5=$(dd if="$img" bs=1M 2>/dev/null | md5sum | cut -d' ' -f1)
                local dev_md5=$(dd if="$dev" bs=1M 2>/dev/null | md5sum | cut -d' ' -f1)
                if [  "$img_md5" == "$dev_md5"  ]; then
                    echo -e "${GREEN}Verification passed${NC}"
                else
                    echo -e "${RED}Verification failed${NC}"
                fi
                read -p "  Press Enter to continue..."
                ;;
            3)
                read -p "  Device: " dev
                echo "  Calculating hash..."
                sha256sum "$dev" 2>/dev/null
                read -p "  Press Enter to continue..."
                ;;
            4)
                read -p "  Device: " dev
                echo "  Attempting file recovery..."
                if command -v foremost >/dev/null 2>&1; then
                    foremost -t all -i "$dev" -o /tmp/recovery
                else
                    echo -e "${YELLOW}foremost not available${NC}"
                fi
                read -p "  Press Enter to continue..."
                ;;
            5)
                read -p "  File/device: " file
                if command -v hexdump >/dev/null 2>&1; then
                    hexdump -C "$file" | head -100
                elif command -v xxd >/dev/null 2>&1; then
                    xxd "$file" | head -100
                fi
                read -p "  Press Enter to continue..."
                ;;
            6) return ;;
            *) echo -e "${RED}Invalid option${NC}"; sleep 1 ;;
        esac
    done
}

settings_menu() {
    while true; do
        draw_menu "Settings" \
            "Toggle Safe Mode" \
            "Toggle Dry Run" \
            "Toggle Verbose" \
            "Set Default Options" \
            "Back to Main Menu"
        
        read -p "  Select option [1-5]: " choice
        
        case "$choice" in
            1)
                SAFE_MODE=$((1 - SAFE_MODE))
                if [  ${SAFE_MODE:-0} -eq 1  ]; then
                    echo -e "${GREEN}Safe mode: ON${NC}"
                else
                    echo -e "${YELLOW}Safe mode: OFF${NC}"
                fi
                sleep 1
                ;;
            2)
                DRY_RUN=$((1 - DRY_RUN))
                if [  ${DRY_RUN:-0} -eq 1  ]; then
                    echo -e "${GREEN}Dry run: ON${NC}"
                else
                    echo -e "${YELLOW}Dry run: OFF${NC}"
                fi
                sleep 1
                ;;
            3)
                VERBOSE=$((1 - VERBOSE))
                if [  ${VERBOSE:-0} -eq 1  ]; then
                    echo -e "${GREEN}Verbose: ON${NC}"
                else
                    echo -e "${YELLOW}Verbose: OFF${NC}"
                fi
                sleep 1
                ;;
            4)
                echo "Default options configured"
                sleep 1
                ;;
            5) return ;;
            *) echo -e "${RED}Invalid option${NC}"; sleep 1 ;;
        esac
    done
}

# Run main menu
main_menu
