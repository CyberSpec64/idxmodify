#!/bin/sh
#==============================================================================
# idxmodify - Disk Imaging Tool
#==============================================================================

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
CYAN='\033[0;36m'
NC='\033[0m'

usage() {
    cat << EOF
${CYAN}idxm-disk-image${NC} - Create forensic disk images

Usage: idxm-disk-image [options] <source> <destination>

Options:
    -b, --block-size <size>  Block size (default: 4M)
    -s, --split <size>       Split image into chunks (e.g., 4G, 1G)
    -c, --compress           Compress output (gzip)
    -v, --verify             Verify image after creation
    -h, --hash <type>        Hash algorithm (md5, sha1, sha256)
    -l, --log <file>         Log file for results
    -f, --force              Overwrite existing files
    -h, --help               Show this help

Examples:
    idxm-disk-image /dev/sda /mnt/backup/sda.img
    idxm-disk-image -c -v /dev/sda /mnt/backup/sda.img.gz
    idxm-disk-image -s 4G -c /dev/sda /mnt/backup/sda_

EOF
}

create_image() {
    local src="$1"
    local dst="$2"
    local block_size="$3"
    local compress="$4"
    local verify="$5"
    local hash_type="$6"
    local split_size="$7"
    
    if [  ! -b "$src"  ]; then
        echo -e "${RED}Error: $src is not a block device${NC}"
        return 1
    fi
    
    echo -e "${CYAN}═══════════════════════════════════════════════════════════════${NC}"
    echo -e "${CYAN}  idxmodify - Disk Imaging Tool${NC}"
    echo -e "${CYAN}═══════════════════════════════════════════════════════════════${NC}"
    echo ""
    echo -e "Source:       ${GREEN}$src${NC}"
    echo -e "Destination:  ${GREEN}$dst${NC}"
    echo -e "Block size:   ${block_size}"
    echo -e "Compress:     ${compress}"
    echo -e "Verify:       ${verify}"
    echo -e "Hash:         ${hash_type}"
    echo -e "Split:        ${split_size:-disabled}"
    echo ""
    
    # Get source size
    local src_size=$(blockdev --getsize64 "$src" 2>/dev/null || stat -c%s "$src" 2>/dev/null || echo "0")
    echo -e "${CYAN}Source size: $(numfmt --to=iec $src_size)${NC}"
    echo ""
    
    # Create image
    echo -e "${GREEN}Creating disk image...${NC}"
    
    local dd_cmd="dd if=$src bs=$block_size conv=sync,noerror"
    local verify_cmd=""
    
    if [  "$compress" == "1"  ]; then
        if [  -n "$split_size"  ]; then
            dd_cmd="$dd_cmd | gzip | split -b $split_size - $dst"
        else
            dd_cmd="$dd_cmd | gzip > $dst"
        fi
    else
        if [  -n "$split_size"  ]; then
            dd_cmd="$dd_cmd | split -b $split_size - $dst"
        else
            dd_cmd="$dd_cmd of=$dst"
        fi
    fi
    
    eval "$dd_cmd" status=progress
    
    if [  $? -ne 0  ]; then
        echo -e "${RED}Error: Imaging failed${NC}"
        return 1
    fi
    
    echo ""
    echo -e "${GREEN}Image created successfully${NC}"
    
    # Calculate hash
    if [  -n "$hash_type"  ]; then
        echo -e "${CYAN}Calculating hash...${NC}"
        case "$hash_type" in
            md5)    md5sum "$dst" ;;
            sha1)   sha1sum "$dst" ;;
            sha256) sha256sum "$dst" ;;
        esac
    fi
    
    # Verify if requested
    if [  "$verify" == "1"  ]; then
        echo -e "${CYAN}Verifying image...${NC}"
        
        local verify_src="$src"
        local verify_dst="$dst"
        
        if [  "$compress" == "1"  ]; then
            verify_dst="/tmp/verify_img.bin"
            gunzip -c "$dst" > "$verify_dst"
        fi
        
        local src_md5=$(dd if="$verify_src" bs=$block_size 2>/dev/null | md5sum | cut -d' ' -f1)
        local dst_md5=$(md5sum "$verify_dst" | cut -d' ' -f1)
        
        if [  "$src_md5" == "$dst_md5"  ]; then
            echo -e "${GREEN}Verification PASSED (MD5: $src_md5)${NC}"
        else
            echo -e "${RED}Verification FAILED${NC}"
            echo -e "Source MD5: $src_md5"
            echo -e "Image MD5:  $dst_md5"
        fi
        
        [  "$compress" == "1"  ] && rm -f "$verify_dst"
    fi
    
    echo ""
    echo -e "${GREEN}Done!${NC}"
}

# Parse arguments
SRC=""
DST=""
BLOCK_SIZE="4M"
COMPRESS=0
VERIFY=0
HASH_TYPE=""
SPLIT_SIZE=""
FORCE=0

while [  $# -gt 0  ]; do
    case "$1" in
        -b|--block-size)
            BLOCK_SIZE="$2"
            shift 2
            ;;
        -s|--split)
            SPLIT_SIZE="$2"
            shift 2
            ;;
        -c|--compress)
            COMPRESS=1
            shift
            ;;
        -v|--verify)
            VERIFY=1
            shift
            ;;
        -h|--hash)
            HASH_TYPE="$2"
            shift 2
            ;;
        -f|--force)
            FORCE=1
            shift
            ;;
        *)
            if [  -z "$SRC"  ]; then
                SRC="$1"
            elif [  -z "$DST"  ]; then
                DST="$1"
            fi
            shift
            ;;
    esac
done

if [  -z "$SRC"  ] || [  -z "$DST"  ]; then
    echo -e "${RED}Error: Source and destination required${NC}"
    usage
    exit 1
fi

create_image "$SRC" "$DST" "$BLOCK_SIZE" "$COMPRESS" "$VERIFY" "$HASH_TYPE" "$SPLIT_SIZE"
